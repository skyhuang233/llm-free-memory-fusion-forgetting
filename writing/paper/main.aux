\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comprehensive results on LoCoMo-10. Per-model rows show DFM-Fusion (DFM), LLM-Fusion (LLM), and No-Fusion (No) across all six question categories; $\Delta $ is DFM minus LLM on multi-hop F1; $p$ is the paired t-test $p$-value. The \textbf  {Average} row reports six-model means; bolded cells indicate the best-performing method per column. Ablation rows (\textit  {indented}) show DFM variant averages; \textit  {italicized} LLM and No values repeat the fixed baselines from the Average row (LLM-Fusion and No-Fusion are unaffected by DFM ablations); $\Delta ^\dagger $ compares the ablation to DFM-Fusion on multi-hop F1. DFM-Fusion eliminates all maintenance-time LLM calls: 69.13$\times $ average maintenance speedup, 11.74\% total-call reduction, 3.88\% cost savings. Cost figures use \texttt  {DeepSeek-V3.2} pricing (\$0.27/1M input, \$1.10/1M output); local Ollama models incur zero direct API cost.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:main_results}{{1}{5}{Comprehensive results on LoCoMo-10. Per-model rows show DFM-Fusion (DFM), LLM-Fusion (LLM), and No-Fusion (No) across all six question categories; $\Delta $ is DFM minus LLM on multi-hop F1; $p$ is the paired t-test $p$-value. The \textbf {Average} row reports six-model means; bolded cells indicate the best-performing method per column. Ablation rows (\textit {indented}) show DFM variant averages; \textit {italicized} LLM and No values repeat the fixed baselines from the Average row (LLM-Fusion and No-Fusion are unaffected by DFM ablations); $\Delta ^\dagger $ compares the ablation to DFM-Fusion on multi-hop F1. DFM-Fusion eliminates all maintenance-time LLM calls: 69.13$\times $ average maintenance speedup, 11.74\% total-call reduction, 3.88\% cost savings. Cost figures use \texttt {DeepSeek-V3.2} pricing (\$0.27/1M input, \$1.10/1M output); local Ollama models incur zero direct API cost}{table.1}{}}
\newlabel{tab:main_results@cref}{{[table][1][]1}{[1][5][]5}{}{}{}}
